<div class="h-[70vh] md:h-[80vh] overflow-hidden bg-gray-300 relative">
  {% assign settings = section.settings %}
  {% if settings.hero_image %}
    <div class="overlay absolute inset-0 bg-black/20">
    <!-- hero section details -->
      <div class="h-full w-full flex md:max-w-110  md:ml-60">
        <div class=" flex  justify-end items-end mb-30 mx-10 md:mx-0">
          <div class="flex flex-col-reverse gap-y-10">
            <!--Button with link-->
            <a class="py-3 px-6 w-fit bg-white text-black font-bold uppercase" href="{{ settings.hero_button_ref }}">
              {{ settings.button_text |  escape }}
            </a>
            <!-- Hero Title-->
            <h2 class="md:text-5xl text-3xl font-extrabold uppercase text-white shadow-lg">
              {{ settings.title }}
            </h2>
            <!--Small discription-->
            <p class="text-white text-xs font-bold">{{ settings.discription }}</p>
          </div>
         
        </div>

      </div>
    </div>
    <!--Hero image-->
    <img class="h-full w-full object-cover" src="{{ settings.hero_image | image_url: width: 1500 }}" loading="lazy" alt="{{ settings.title }}">
  {% else %}
    <div class="h-full w-full flex text-center items-center justify-center flex-1 bg-gray-500">
      <span class="h-10 w-10 border-4 border-red-400 border-t-transparent rounded-full animate-spin"></span>
    </div>
  {% endif %}
  

</div>
{% schema %}
{
  "name": "Hero",
  "settings": [
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Hero Image"
      },
      {
        "type": "text",
        "label": "Title",
        "id": "title",
        "default": "Hero Section"
      },
      {
        "type": "text",
        "label": "Discriptin",
        "id": "discription",
        "default": "Hero Section Discription"
      },
      {
        "type": "url",
        "id": "hero_button_ref",
        "label": "Button Distination"
        
      },
      {
        "type": "text",
        "id":"button_text",
        "label": "Button Text",
        "default":"Hero Text"
      }
    
    ]
}
{% endschema %}