<footer id="main-footer"  class="my-10">
  <div class="flex flex-col  justify-center items-center">
    <div class="flex flex-col  justify-center items-center gap-4">
      <a href="{{ routes.root_url }}">
        <span class="text-red-400">
          {% render 'logo-svg' %}
        </span>
      </a>
      <h2 class="uppercase text-2xl font-bold text-black w-1/2 ">
        SUBSCRIBE FOR THE LATEST NEWS, EVENTS, & PROMOS
      </h2>

      
      
    </div>
    <div class="flex flex-col md:flex-row justify-center mt-10 gap-8 md:gap-4 text-sm px-4">
      
      <div class="form-mail w-full md:w-1/3 lg:w-1/4">
        {% form 'customer', id: 'FooterEmailForm', class: 'w-full' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          {% if form.posted_successfully? %}
            <p class="text-green-600 text-xs mb-2 font-bold">Thanks for subscribing!</p>
          {% elsif form.errors %}
            <p class="text-red-600 text-xs mb-2">{{ form.errors | default_errors }}</p>
          {% endif %}

          <div class="flex justify-between border-b border-gray-300 py-2">
            <input 
              class="focus:outline-none w-full bg-transparent" 
              type="email" 
              name="contact[email]" 
              id="NewsletterEmail"
              value="{{ form.email }}"
              placeholder="Email address" 
              required
            >
            <button class="text-xs font-bold uppercase ml-2 hover:text-gray-600 transition-colors" type="submit">Subscribe</button>
          </div>
        {% endform %}
        
        <p class="text-xs text-gray-500 mt-2">
          * E-mail Address Required
        </p>
      </div>

      <div class="form-phone w-full md:w-1/3 lg:w-1/4">
        {% form 'customer', id: 'FooterSMSForm', class: 'w-full' %}
          <input type="hidden" name="contact[tags]" value="newsletter, sms">

          {% if form.posted_successfully? %}
            <p class="text-green-600 text-xs mb-2 font-bold">Thanks for subscribing!</p>
          {% elsif form.errors %}
            <p class="text-red-600 text-xs mb-2">{{ form.errors | default_errors }}</p>
          {% endif %}

          <div class="flex justify-between border-b border-gray-300 py-2">
            <input 
              class="focus:outline-none w-full bg-transparent" 
              type="tel" 
              name="contact[phone]" 
              id="NewsletterPhone"
              value="{{ form.phone }}"
              placeholder="Phone number"
              required
            >
            <button class="text-xs font-bold uppercase ml-2 hover:text-gray-600 transition-colors" type="submit">Subscribe</button>
          </div>
        
          <div class="flex items-start gap-3 mt-3 text-xs text-gray-500">
            <input class="mt-0.5 cursor-pointer shrink-0" type="checkbox" name="sms_consent" id="sms_consent" required>
            <label class="cursor-pointer leading-relaxed" for="sms_consent">
              ** I agree to receive recurring automated marketing text messages (e.g. cart reminders) at the phone number provided. Consent is not a condition to purchase. Msg & data rates may apply. Msg frequency varies. Reply HELP for help and STOP to cancel. View our <a href="/policies/terms-of-service" class="underline hover:text-gray-800">Terms of Service</a> and <a href="/policies/privacy-policy" class="underline hover:text-gray-800">Privacy Policy</a>.
            </label>
          </div>
        {% endform %}
      </div>
      
    </div>
      
    <fake-select class="block text-left relative w-60 mt-10" style="z-index: 100;">
      <button id="selecCountry" data-dropdown-action="toggle-dropdown" class="flex gap-4 h5 font-body items-center px-2 w-full border-2 border-primaryDark h-12 [&.open]:border-b-0 open" role="combobox" aria-expanded="true">
        <div data-fake-select-value class="flex gap-4 items-center text-left">
          <div class="flex-shrink text-left"><span class="uppercase">Select Region</span></div>
        </div>
        <div data-rotate class="ml-auto w-3 h-3 transition-all duration-200" style="transform: rotate(-180deg);">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 8 14"><path fill="currentColor" d="M1.351 14 0 12.658 5.693 7 0 1.342 1.351 0 7.72 6.329a.945.945 0 0 1 0 1.342z"></path></svg>
        </div>
      </button>

      <div data-dropdown class="absolute w-full top-full overflow-hidden transition-all duration-200 shadow bg-primaryLight z-10" style="height: 0px; opacity: 0;">
        <ul class="border-2 border-t-0 border-primaryDark max-h-[440px]" id="countryDropdown" role="listbox">
          
          {% for block in section.blocks %}
            {% if block.type == 'country_link' %}
              <li data-fake-option class="border-b border-secondaryLight" role="option" {{ block.shopify_attributes }}>
                <button data-value="{{ block.settings.url }}" data-dropdown-action="url" class="flex gap-4 items-center px-2 transition duration-200 focus:bg-secondaryLight hover:bg-secondaryLight h5 font-body w-full h-12">
                  {% if block.settings.flag != blank %}
                    {{ block.settings.flag | image_url: width: 30 | image_tag: loading: 'lazy' }}
                  {% endif %}
                  <div class="flex-shrink text-left">
                    <span class="uppercase">{{ block.settings.name }}</span>
                  </div>
                </button>
              </li>
            {% endif %}
          {% endfor %}

        </ul>
      </div>
    </fake-select>
  </div>





<script src="{{ 'currency.js' |  asset_url }}"></script>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Country Selector Settings"
    }
  ],
  "blocks": [
    {
      "type": "country_link",
      "name": "Country Store Link",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Country Name",
          "default": "United States"
        },
        {
          "type": "image_picker",
          "id": "flag",
          "label": "Country Flag Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Store URL",
          "info": "Link to the specific regional store (e.g., uk.yourstore.com)"
        }
      ]
    }
  ]
}
{% endschema %}